{
  "name": "echorent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "EchoRent — car rental UI. Same goal. Same cars. A great experience for travellers.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --project unit",
